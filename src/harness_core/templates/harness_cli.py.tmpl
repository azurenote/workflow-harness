#!/usr/bin/env python3
"""Project-local workflow harness CLI.

Generated by workflow-harness. Keep tracker-specific operations in project.py or
repo-specific scripts; this CLI owns local file/git operations.
"""

from __future__ import annotations

import argparse
from pathlib import Path

from harness.config import PLAN_DIR
from harness_core.git import create_branch, create_worktree
from harness_core.io import print_json
from harness_core.local import (
    extract_base_branch,
    find_draft_plan_file,
    parse_frontmatter,
    plan_file_for_issue,
    rename_plan_to_issue,
)


def _find_draft_plan(_args: argparse.Namespace) -> int:
    print(find_draft_plan_file(PLAN_DIR))
    return 0


def _rename_plan(args: argparse.Namespace) -> int:
    print(rename_plan_to_issue(args.plan_path, args.issue_number))
    return 0


def _get_base(args: argparse.Namespace) -> int:
    plan = plan_file_for_issue(args.issue_number, PLAN_DIR)
    frontmatter = parse_frontmatter(plan.read_text())
    parent = frontmatter.get("parent_issue") or None
    print_json(
        {
            "base_branch": extract_base_branch(plan),
            "parent_issue": int(parent) if parent and parent.isdigit() else parent,
        }
    )
    return 0


def _create_branch(args: argparse.Namespace) -> int:
    print(create_branch(args.branch_name, base_ref=args.base_ref))
    return 0


def _create_worktree(args: argparse.Namespace) -> int:
    print(create_worktree(args.path, args.branch_name, base_ref=args.base_ref))
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="harness_cli.py")
    sub = parser.add_subparsers(dest="command", required=True)

    find = sub.add_parser("find-draft-plan")
    find.set_defaults(func=_find_draft_plan)

    rename = sub.add_parser("rename-plan")
    rename.add_argument("plan_path", type=Path)
    rename.add_argument("issue_number", type=int)
    rename.set_defaults(func=_rename_plan)

    get_base = sub.add_parser("get-base")
    get_base.add_argument("issue_number", type=int)
    get_base.set_defaults(func=_get_base)

    branch = sub.add_parser("create-branch")
    branch.add_argument("branch_name")
    branch.add_argument("--base-ref")
    branch.set_defaults(func=_create_branch)

    worktree = sub.add_parser("create-worktree")
    worktree.add_argument("path")
    worktree.add_argument("branch_name")
    worktree.add_argument("--base-ref")
    worktree.set_defaults(func=_create_worktree)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
