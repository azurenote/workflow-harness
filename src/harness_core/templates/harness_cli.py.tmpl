#!/usr/bin/env python3
"""Project-local workflow harness entry point.

PROJECT-OWNED: `harness-update` preserves this file and never overwrites it, so
your own subcommands can never be clobbered by a template sync. It composes the
core command surface (supplied by the workflow-harness library) with this
project's own tracker/ADR commands.

The eight core commands come from `harness_core.cli.build_core_parser()`. Add
project-specific commands in `register_project()` below — the single place where
this project's command tree is assembled.
"""

from __future__ import annotations

import sys
from pathlib import Path

# Make sibling modules (project.py, harness/) importable no matter how this
# script is invoked — direct path, `python -m`, or under pytest.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from harness.config import BASE_BRANCH  # noqa: E402
from harness_core.cli import build_core_parser, dispatch, subparsers  # noqa: E402


def register_project(sub) -> None:
    """Register this project's commands onto the core subparsers action.

    This is the one composition point. Duplicate names (a project command
    shadowing a core one) raise immediately via the guarded subparsers.
    """
    import project

    project.register(sub)

    # When this project grows an ADR adapter, register it here too, e.g.:
    #     from harness import adr_cli
    #     adr_cli.register(sub)


def build():
    """Build the full parser: core commands plus this project's commands.

    `clean_up_bases` carries this project's declared base branch into the core's
    `clean-up`. The core cannot read skill-config.yaml, and a base branch it does
    not know about is one it does not protect from deletion.
    """
    parser = build_core_parser(clean_up_bases=sorted({BASE_BRANCH, "develop", "main"}))
    register_project(subparsers(parser))
    return parser


def main(argv: list[str] | None = None) -> int:
    return dispatch(build(), argv)


if __name__ == "__main__":
    raise SystemExit(main())
