"""Project-local workflow harness configuration.

Generated by workflow-harness. Project-specific values live in
.claude/skill-config.yaml and should be preserved across updates.

Paths are exposed as ``@lru_cache`` functions (``plan_dir()`` / ``state_file()``)
rather than eagerly-computed module constants, so that:

- Import is side-effect free — ``import harness.config`` runs no ``git``
  subprocess. pytest collection and CI sandboxes stay safe. (A prior harness
  sync made these eager module constants and broke exactly this.)
- Every caller resolves to the *main worktree* root even when invoked from a
  linked worktree — ``.task/plan/`` and ``.claude/state.json`` are gitignored
  and exist only in the main checkout.

The upper-case aliases ``PLAN_DIR`` / ``STATE_FILE`` / ``SKILL_CONFIG`` are kept
for backward compatibility with older ``harness_cli.py`` copies in sibling repos
that do ``from harness.config import PLAN_DIR``. They are served lazily through
module ``__getattr__`` (PEP 562), so importing this module still triggers no
subprocess — the value is computed only on first access.
"""

from __future__ import annotations

from functools import lru_cache
from pathlib import Path

# ── Re-export generic patterns from the core library ────────────────────────
from harness_core.config import (  # noqa: F401
    is_draft_plan,
    is_committed_plan,
    extract_issue_number,
)
from harness_core.git import main_worktree_root


BASE_BRANCH = "$BASE_BRANCH"


@lru_cache(maxsize=1)
def plan_dir() -> Path:
    """Absolute path of ``.task/plan/`` rooted at the main worktree.

    ``.task/plan/`` is gitignored, so plan files exist only in the main worktree
    checkout. Always resolve relative to the main worktree regardless of the
    current CWD.

    Tests that change CWD in-process must clear all three caches together —
    ``plan_dir``, ``state_file``, and ``harness_core.git.main_worktree_root`` —
    otherwise the wrappers return stale paths even after the underlying cache is
    cleared.
    """
    return main_worktree_root() / ".task" / "plan"


@lru_cache(maxsize=1)
def state_file() -> Path:
    """Absolute path of ``.claude/state.json`` rooted at the main worktree.

    The state file is the single source of truth for harness transaction logs,
    so it must not diverge across linked worktrees. See ``plan_dir()`` for
    cache-invalidation notes.
    """
    return main_worktree_root() / ".claude" / "state.json"


# Intentionally CWD-relative: ADRs are tracked content, and a feature branch may
# carry in-progress ADR files the main worktree has not yet merged. ``adr-search``
# should reflect the current branch's contents, not the main worktree's.
ADR_DIR = Path("docs/arch-decision-record")


def __getattr__(name: str):
    """Serve the legacy upper-case path aliases lazily (PEP 562).

    Older ``harness_cli.py`` copies in sibling repos ``from harness.config import
    PLAN_DIR``. Computing them here — on attribute access — instead of at module
    top level keeps ``import harness.config`` free of any ``git`` subprocess.
    """
    if name == "PLAN_DIR":
        return plan_dir()
    if name == "STATE_FILE":
        return state_file()
    if name == "SKILL_CONFIG":
        return main_worktree_root() / ".claude" / "skill-config.yaml"
    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
