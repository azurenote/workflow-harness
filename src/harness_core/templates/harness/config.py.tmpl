"""Project-local workflow harness configuration.

Generated by workflow-harness. Project-specific values live in
.claude/skill-config.yaml and should be preserved across updates.

Paths are exposed as ``@lru_cache`` functions (``plan_dir()`` / ``state_file()``)
rather than eagerly-computed module constants, so that:

- Import is side-effect free — ``import harness.config`` runs no ``git``
  subprocess. pytest collection and CI sandboxes stay safe. (A prior harness
  sync made these eager module constants and broke exactly this.)
- Gitignored state resolves to the *main worktree* root even when invoked from
  a linked worktree — ``.task/plan/`` and ``.claude/state.json`` exist only in
  the main checkout.
- Tracked content resolves to the working tree that contains CWD —
  ``.claude/skill-config.yaml`` is committed, and a feature branch may change
  it, so it is read at the version the running code's branch carries. The same
  rule as ``ADR_DIR`` below, and the same file the skills read CWD-relative.
  Reading it from the main checkout mixed one branch's code with another
  branch's config in a linked worktree (#23).

The upper-case aliases ``PLAN_DIR`` / ``STATE_FILE`` / ``SKILL_CONFIG`` are kept
for backward compatibility with older ``harness_cli.py`` copies in sibling repos
that do ``from harness.config import PLAN_DIR``. They are served lazily through
module ``__getattr__`` (PEP 562), so importing this module still triggers no
subprocess — the value is computed only on first access.

``GITHUB_PROJECT`` rides the same ``__getattr__`` but is **not** a legacy alias:
it is new, and ``github_project()`` is the form to call. Prefer the function.
Reaching for the alias with ``from harness.config import GITHUB_PROJECT`` resolves
it at import time, which is exactly the work this module is built not to do.
"""

from __future__ import annotations

from functools import lru_cache
from pathlib import Path

# ── Re-export generic patterns from the core library ────────────────────────
from harness_core.config import (  # noqa: F401
    is_draft_plan,
    is_committed_plan,
    extract_issue_number,
)
from harness_core.git import main_worktree_root, worktree_root


BASE_BRANCH = "$BASE_BRANCH"


@lru_cache(maxsize=1)
def plan_dir() -> Path:
    """Absolute path of ``.task/plan/`` rooted at the main worktree.

    ``.task/plan/`` is gitignored, so plan files exist only in the main worktree
    checkout. Always resolve relative to the main worktree regardless of the
    current CWD.

    Tests that change CWD in-process must clear all three caches together —
    ``plan_dir``, ``state_file``, and ``harness_core.git.main_worktree_root`` —
    otherwise the wrappers return stale paths even after the underlying cache is
    cleared. ``github_project`` caches a CWD-dependent value too; clear it when
    moving between worktrees.
    """
    return main_worktree_root() / ".task" / "plan"


@lru_cache(maxsize=1)
def state_file() -> Path:
    """Absolute path of ``.claude/state.json`` rooted at the main worktree.

    The state file is the single source of truth for harness transaction logs,
    so it must not diverge across linked worktrees. See ``plan_dir()`` for
    cache-invalidation notes.
    """
    return main_worktree_root() / ".claude" / "state.json"


def _skill_config_path() -> Path:
    """``.claude/skill-config.yaml`` in the working tree that contains CWD.

    The one place this path is built; ``github_project()`` and the
    ``SKILL_CONFIG`` alias both go through it. Not cached — the answer follows
    CWD.
    """
    return worktree_root() / ".claude" / "skill-config.yaml"


@lru_cache(maxsize=1)
def github_project() -> dict | None:
    """The ``github_project`` block from ``.claude/skill-config.yaml``, or None.

    The GitHub issue metadata contract needs the project's coordinates — owner,
    project number, status option names, field names — and they are this
    project's constants, so they live in the config file rather than in code.
    See ``skills/_shared/references/github-issue-fields.md``.

    Lazy for the same reason as ``plan_dir()``: resolving the config path runs
    ``git``, and importing this module must stay side-effect free. Returns None
    when the block is absent or PyYAML is not installed — every command then
    reports the project fields as not applied instead of failing.

    The file is ``_skill_config_path()`` — the current worktree's copy, not the
    main checkout's; see the module docstring.
    """
    try:
        import yaml
    except ModuleNotFoundError:
        return None
    path = _skill_config_path()
    if not path.exists():
        return None
    try:
        loaded = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except yaml.YAMLError:
        return None
    block = loaded.get("github_project")
    return block if isinstance(block, dict) else None


# Intentionally CWD-relative: ADRs are tracked content, and a feature branch may
# carry in-progress ADR files the main worktree has not yet merged. ``adr-search``
# should reflect the current branch's contents, not the main worktree's.
ADR_DIR = Path("docs/arch-decision-record")


def __getattr__(name: str):
    """Serve the legacy upper-case path aliases lazily (PEP 562).

    Older ``harness_cli.py`` copies in sibling repos ``from harness.config import
    PLAN_DIR``. Computing them here — on attribute access — instead of at module
    top level keeps ``import harness.config`` free of any ``git`` subprocess.
    """
    if name == "PLAN_DIR":
        return plan_dir()
    if name == "STATE_FILE":
        return state_file()
    if name == "SKILL_CONFIG":
        return _skill_config_path()
    if name == "GITHUB_PROJECT":
        return github_project()
    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
