#!/usr/bin/env python3
"""Project-specific tracker operations + backward-compatible entry point.

Cross-repo callers invoke `.claude/scripts/project.py <command>` by literal path
(the cross-plan skill does this against a sibling repo), so this name is a
contract. This starter forwards to the project's `harness_cli` so a single
command tree stays authoritative.

Define this project's tracker commands inside `register(sub)`; `harness_cli`'s
`register_project()` calls it, so the same definitions serve both entry points.
"""

from __future__ import annotations

import sys
from pathlib import Path

# Make harness_cli / harness importable when invoked directly by path.
sys.path.insert(0, str(Path(__file__).resolve().parent))


def register(sub) -> None:
    """Register this project's tracker commands. Empty until the project adds them.

    On GitHub, the shared adapter already implements the issue metadata contract
    (type as the issue type; priority / size / status as project fields; labels
    as area tags only). Opt in instead of reimplementing it — the project
    constants are arguments, so nothing about this project reaches the library:

        # Called here, not imported at module top: `from harness.config import
        # GITHUB_PROJECT` would resolve the alias at import time and read the
        # config on every `import project`. config.py's whole design is that
        # importing it does no work.
        from harness.config import github_project_or_reason
        from harness_core.trackers.github import register_github_commands

        # The loader never raises: an unreadable config comes back as
        # `reason`, not as an exception that would take down every command
        # while the parser builds.
        project, reason = github_project_or_reason()
        if project is not None:
            # The loader checks only that the block is a non-empty mapping;
            # its keys are this project's to validate. The indexing below
            # raises KeyError on a partial block — during the same parser
            # build — so check the keys first if a partial block can get here.
            register_github_commands(
                sub,
                # `owner`/`repo` address the REPOSITORY (repos/{owner}/{repo}),
                # taken from `github_repo: <owner>/<repo>`.
                owner="<owner>",
                repo="<repo>",
                # `project_owner` is the login that owns the BOARD. It is a
                # separate value: a repo under one login can sit on a project
                # owned by another, which is the case this argument exists for.
                project_owner=project["owner"],
                project_number=project["number"],
                initial_status=project["status_names"]["backlog"],
                field_names=project.get("field_names", {}),
            )
        # else: what to do without a block is this project's policy. Fail-open,
        # as here: leave the board commands unregistered — the shared
        # contract's "not applied". Fail-closed: register them as a stub that
        # prints `reason` and returns `ExitCode.REFUSED`
        # (`harness_core.exitcodes`), so a board command says why instead of
        # argparse's "invalid choice". Either way, no early `return`: the
        # project's own commands registered after this must still register.

    That adds create-issue / get-issue / set-fields / audit-fields. See
    skills/_shared/references/github-issue-fields.md for the config block.
    """


def main() -> int:
    import harness_cli

    return harness_cli.main()


if __name__ == "__main__":
    raise SystemExit(main())
